{
  "name": "@e2b/pi",
  "version": "0.1.0",
  "description": "Pi coding agent extension that runs every tool call in an E2B sandbox while the agent runs on your machine",
  "keywords": [
    "e2b",
    "pi-extension",
    "pi-package",
    "sandbox"
  ],
  "homepage": "https://e2b.dev/docs/agents/pi",
  "bugs": {
    "url": "https://github.com/e2b-dev/pi-extension/issues"
  },
  "license": "MIT",
  "author": "E2B",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2b-dev/pi-extension.git"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware index.ts src scripts",
    "format": "oxfmt index.ts src scripts package.json tsconfig.json",
    "format:check": "oxfmt --check index.ts src scripts package.json tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "test:live": "tsx scripts/live.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run smoke"
  },
  "dependencies": {
    "e2b": "^2.55.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "^4.23.15",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "typebox": "^1"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
